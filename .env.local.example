# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored — never commit real secrets.

# ─────────────────────────────────────────────────────────────────────────────
# Database (Prisma → Supabase Postgres)
# Supabase dashboard → Project Settings → Database → Connection string.
# ─────────────────────────────────────────────────────────────────────────────

# Pooled connection (PgBouncer, port 6543). Used by the app at runtime.
# Use the "Transaction" pooler URL and append ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432). Used by Prisma Migrate / introspection only.
# Use the "Session"/direct connection string (no pgbouncer).
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────────────────────
# Supabase Auth + Storage (client + server)
# Supabase dashboard → Project Settings → API.
# ─────────────────────────────────────────────────────────────────────────────

# Project URL — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"

# anon / public key — safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# service_role key — SERVER ONLY. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_ and never use it in client components.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic (Phase 2.1 — AI interview question generation)
# console.anthropic.com → API keys. SERVER ONLY.
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="your-anthropic-api-key"

# ─────────────────────────────────────────────────────────────────────────────
# LiveKit (Phase 2.2d — browser ↔ real voice interview)
# livekit.io dashboard → Settings → Keys. SERVER ONLY (these mint join tokens
# and dispatch the agent). Use the SAME values as voice-agent/.env so the
# Next.js app and the Python voice agent point at the same LiveKit project.
# ─────────────────────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud
