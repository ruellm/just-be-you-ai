// Just Be You — Prisma schema
// Phase 1: full platform with MOCKED AI interview results.
// The interview is ON-DEMAND / ASYNCHRONOUS — no scheduling, no human
// interviewer, no calendar. Application status reflects this:
// "interview_completed", never "interview_scheduled".
//
// SCOPE NOTES (Phase 2, intentionally NOT modeled here):
//   - payments / subscription tiers (seat counts, trial seats)
//   - liveness / face verification
//   - audio recordings, AI question banks, embeddings-based matching
// Matching in Phase 1 is a simple skill-overlap count computed at query time,
// so it needs no tables of its own.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase: pooled connection for the app, direct connection for migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  candidate
  business
  admin
}

enum EmploymentType {
  full_time
  part_time
  freelance
  self_employed
  contract
  internship
  other
}

enum WorkMode {
  onsite
  remote
  hybrid
}

// Used for both a Job's required level and an InterviewResult's achieved tier.
// Pass/fail is derived: InterviewResult.tier (a Level) must be >= Job.level.
enum Level {
  entry
  novice
  advanced
  expert
}

enum ApplicationStatus {
  draft
  submitted
  interview_completed // on-demand interview finished; NOT "scheduled"
  passed
  failed
  archived
}

enum JobStatus {
  open
  closed
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

// One row per Supabase Auth user. `id` is supplied by Supabase Auth (auth.users
// UUID) — we do NOT generate it here. Email + role + created_at live alongside it.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())

  // Set true when an admin provisions a business/admin account; flipped to
  // false after the user sets their own password on first login.
  requiresPasswordChange Boolean @default(false)

  // Exactly one of these is populated, depending on role.
  candidateProfile CandidateProfile?
  company          Company?

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Business side
// ─────────────────────────────────────────────────────────────────────────────

// One business user → one company (Phase 1). userId is unique to enforce 1:1.
model Company {
  id          String   @id @default(cuid())
  userId      String   @unique @db.Uuid
  name        String
  description String?
  website     String?
  logoUrl     String?
  createdAt   DateTime @default(now())

  // Company profile details (business redesign). All optional; free text
  // except yearFounded. `type` is free text ("Privately Held", …) — no enum.
  yearFounded  Int?
  contactEmail String?
  phone        String?
  headquarters String?
  type         String?
  industry     String?

  seatsTotal      Int @default(25)
  seatsAdjustment Int @default(0)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs           Job[]
  profileUnlocks ProfileUnlock[]

  @@map("companies")
}

model ProfileUnlock {
  id                 String   @id @default(cuid())
  companyId          String
  candidateProfileId String
  createdAt          DateTime @default(now())

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@unique([companyId, candidateProfileId])
  @@map("profile_unlocks")
}

// ─────────────────────────────────────────────────────────────────────────────
// Candidate side
// ─────────────────────────────────────────────────────────────────────────────

model CandidateProfile {
  id     String @id @default(cuid())
  userId String @unique @db.Uuid

  // Basic info
  firstName      String?
  middleName     String? // profile redesign P1 (optional)
  lastName       String?
  suffix         String? // e.g. "Jr.", "III" (profile redesign P1, optional)
  country        String? // country of residence
  city           String? // optional per spec
  phone          String?
  linkedinUrl    String?
  expectedSalary Int? // amount only; currency assumed PHP for now
  nationality    String?

  // Profile summary + resume
  summary   String?
  resumeUrl String? // Supabase Storage object path (private bucket)

  // Extracted resume text (Phase 1.5) — for the Phase 2 AI interview.
  parsedResumeText String? // null when no resume or parsing failed
  resumeParsedAt   DateTime? // null when not yet parsed

  // Claude-cleaned resume text (Phase 2.4): parsedResumeText with references,
  // personal data, and contact details stripped. Written at Apply time; null for
  // older applications — interview prompt builders fall back to parsedResumeText.
  cleanedResumeText String?

  // Languages spoken (e.g. ["English", "Filipino"])
  languages String[]

  // Skills-page header fields (from the UX spec). See judgment-call note in the
  // explanation: these come from the doc, not the explicit field list.
  totalYearsExperience Int?
  preferredRole        String?

  // Google's picture, refreshed from user_metadata on EVERY sign-in
  // (ensureUserRow overwrites it), so it can never hold a user-set value.
  avatarUrl String?

  // User-set profile image URL (U3, "Edit Profile Image" modal). Kept separate
  // from avatarUrl precisely because that one is clobbered at each login; this
  // takes precedence when set, and covers email-signup users who have no
  // Google picture at all.
  profileImageUrl String?

  // Drives the hiring-company reveal (see lib/company-visibility.ts). Free is
  // the default; nothing writes `professional` yet — there is no billing flow.
  tier CandidateTier @default(free)

  interviewSeatsTotal      Int @default(2)
  interviewSeatsAdjustment Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  educations      Education[]
  workExperiences WorkExperience[]
  projects        Project[]
  skills          CandidateSkill[]
  applications    Application[]
  profileUnlocks  ProfileUnlock[]

  @@map("candidate_profiles")
}

model Education {
  id                 String    @id @default(cuid())
  candidateProfileId String
  school             String
  country            String?
  degree             String?
  fieldOfStudy       String?
  startDate          DateTime?
  endDate            DateTime?
  currentlyStudying  Boolean   @default(false)

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
  @@map("educations")
}

model WorkExperience {
  id                 String         @id @default(cuid())
  candidateProfileId String
  position           String
  companyName        String
  startDate          DateTime?
  endDate            DateTime?
  currentlyWorking   Boolean        @default(false)
  employmentType     EmploymentType
  description        String?

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
  @@map("work_experiences")
}

// Projects are a standalone profile section (profile redesign P3): personal /
// academic / freelance projects belong to the candidate, not to an employer.
// (Re-parented from WorkExperience; migration 20260816000000 backfills.)
model Project {
  id                 String    @id @default(cuid())
  candidateProfileId String
  name               String
  url                String?
  startDate          DateTime?
  endDate            DateTime?
  ongoing            Boolean   @default(false)
  description        String?
  screenshots        String[] // Supabase Storage object URLs

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  skills           ProjectSkill[]

  @@index([candidateProfileId])
  @@map("projects")
}

// ─────────────────────────────────────────────────────────────────────────────
// Skills taxonomy (seeded with ~50 common IT + non-IT skills)
// ─────────────────────────────────────────────────────────────────────────────

model Skill {
  id       String  @id @default(cuid())
  name     String  @unique
  category String? // optional grouping (e.g. "IT", "Healthcare") — aids seeding/filtering

  candidateSkills CandidateSkill[]
  projectSkills   ProjectSkill[]
  jobSkills       JobSkill[]

  @@map("skills")
}

// Candidate ↔ Skill, with self-rated years of experience.
model CandidateSkill {
  id                 String @id @default(cuid())
  candidateProfileId String
  skillId            String
  yearsOfExperience  Int    @default(0)

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  skill            Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateProfileId, skillId])
  @@index([skillId])
  @@map("candidate_skills")
}

// Project ↔ Skill (skills used on a project).
model ProjectSkill {
  id        String @id @default(cuid())
  projectId String
  skillId   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([projectId, skillId])
  @@index([skillId])
  @@map("project_skills")
}

// ─────────────────────────────────────────────────────────────────────────────
// Jobs
// ─────────────────────────────────────────────────────────────────────────────

model Job {
  id           String    @id @default(cuid())
  companyId    String
  title        String
  description  String
  roleOverview String?
  requirements String?
  dayToDay     String? // "What does day-to-day look like"
  level        Level
  location     String?
  workMode     WorkMode
  salaryMin    Int? // optional salary range
  salaryMax    Int?
  status       JobStatus @default(open)
  createdAt    DateTime  @default(now())

  // AI interview configuration (Phase 2.1) — optional guidance that improves
  // generated-question quality. Consumed by the question generation pipeline.
  interviewHints        String? @db.Text
  idealCandidateProfile String? @db.Text
  passingCriteria       String? @db.Text

  // Max interview duration in minutes (Phase 2.3). null = use system default (30).
  interviewMaxMinutes Int?

  // Which voice agent this job's interviews use: "basic" | "advanced".
  // Stored + displayed only for now — interview dispatch ignores it and every
  // candidate runs the existing basic voice path.
  voiceAgentType String @default("basic")

  // Rubric must-have sub-criterion keys for this job (see
  // shared/interview-rubric.json). null = use the rubric's defaultMustHave set.
  // No UI yet — the rubric decision engine reads it at grading time.
  mustHaveCriteriaJson Json?

  // Which passing curve maps rubric category scores onto the 0-100 composite:
  // "selective" (straight 3s = 50 = fail) | "standard" (straight 3s = 70 =
  // pass). null = "selective". See shared/interview-rubric.json notes.
  passingBar String?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  skills       JobSkill[]
  applications Application[]

  @@index([companyId])
  @@map("jobs")
}

// Job ↔ Skill (required skills for a job).
model JobSkill {
  id      String @id @default(cuid())
  jobId   String
  skillId String

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}

// ─────────────────────────────────────────────────────────────────────────────
// Applications + (mocked) interview results
// ─────────────────────────────────────────────────────────────────────────────

// A candidate applies to a job at most once. status starts at `draft`.
model Application {
  id                 String            @id @default(cuid())
  candidateProfileId String
  jobId              String
  status             ApplicationStatus @default(draft)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // ElevenLabs conversation id for ADVANCED-path interviews (Phase 3.3).
  // Stamped by completeAdvancedInterview when the voice call ends; the 3.4
  // grading session uses it to fetch the transcript. null for every basic
  // (LiveKit) interview.
  voiceConversationId String?

  candidateProfile CandidateProfile    @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  job              Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviewResult  InterviewResult?
  questions        GeneratedQuestion[]

  @@unique([candidateProfileId, jobId])
  @@index([jobId])
  @@map("applications")
}

// One result per application. Phase 1 seeded fake score/tier/transcript; Phase
// 2.3 fills these from a REAL Claude fit-evaluation of the interview transcript.
// completedAt is when the on-demand interview finished. `tier` reuses the Level
// enum; the candidate passes a job when tier >= Job.level.
//
// The Phase 2.3 qualitative fields carry Prisma-level defaults so this migration
// is safe against pre-existing (Phase 1/2.2) rows; the save path always supplies
// real values, so the defaults only ever backfill historical rows.
model InterviewResult {
  id            String   @id @default(cuid())
  applicationId String   @unique
  score         Float
  tier          Level
  transcript    String
  completedAt   DateTime @default(now())

  // Wall-clock length of the interview session, in seconds (U4). Nullable:
  // rows written before this existed have no duration and render a placeholder.
  // Basic tier = the agent's own monotonic clock; advanced tier =
  // ElevenLabs metadata.call_duration_secs. Same unit on both.
  durationSeconds Int?

  // Phase 2.3 — real fit evaluation (see lib/evaluate.py / save_result.py).
  passed         Boolean @default(false)
  fitSummary     String  @default("") @db.Text
  strengthsJson  Json    @default("[]") // list of EvidenceItem {dimension, evidence, impact}
  concernsJson   Json    @default("[]") // list of EvidenceItem
  recommendation String  @default("consider") // "hire" | "consider" | "pass"
  fitSignalsJson Json    @default("[]") // raw signals the AI noted mid-interview (internal)

  // Weighted-rubric scoring (see shared/interview-rubric.json). Nullable —
  // nothing writes these yet (scoring lands in a later session); old rows and
  // old-style results simply leave them null while the fit fields above keep
  // working during the transition.
  rubricScoresJson Json? // per-category, per-sub-criterion 1-5 score + evidence quote
  compositeScore   Float? // 0-100 weighted composite
  verdict          String? // "strong_pass" | "pass" | "borderline" | "fail" (rubric scoreBands keys)
  gatesFiredJson   Json? // which must-have hard gates fired, if any

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("interview_results")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI question configuration (admin-managed; powers the Phase 2 AI interview)
// ─────────────────────────────────────────────────────────────────────────────

model QuestionSet {
  id          String   @id @default(cuid())
  name        String
  vertical    String // e.g. "IT", "Healthcare", "BPO", "Skilled Trades", "General"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]

  @@map("question_sets")
}

model Question {
  id            String   @id @default(cuid())
  questionSetId String
  text          String
  order         Int
  createdAt     DateTime @default(now())

  questionSet QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)

  @@index([questionSetId])
  @@map("questions")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI-generated interview questions per application (Phase 2.1)
// ─────────────────────────────────────────────────────────────────────────────

// Candidate subscription tier (U5). Deliberately on CandidateProfile, NOT on
// User: the business tiers on the pricing page are a different set entirely
// (Starter / Professional / Scale / Enterprise) and belong on Company when they
// land. One shared column on User would carry two unrelated meanings — do not
// consolidate these later.
enum CandidateTier {
  free
  professional
}

enum QuestionCategory {
  core
  personalized
  behavioral
}

model GeneratedQuestion {
  id            String           @id @default(cuid())
  applicationId String
  order         Int
  category      QuestionCategory
  text          String           @db.Text
  rationale     String?          @db.Text // why this question was chosen (LLM-generated, debug)
  createdAt     DateTime         @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("generated_questions")
}
