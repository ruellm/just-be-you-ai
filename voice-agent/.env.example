# Just Be You — voice agent environment template.
# Copy this file to ".env" and fill in real values. Never commit ".env".

# LiveKit Cloud — from the livekit.io dashboard (Settings → Keys).
# LIVEKIT_URL is the wss:// URL of your project.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram — for speech-to-text (console.deepgram.com).
DEEPGRAM_API_KEY=

# OpenAI — for the conversational LLM (GPT-4o).
OPENAI_API_KEY=

# ElevenLabs — for text-to-speech (elevenlabs.io).
ELEVENLABS_API_KEY=
# Pick a voice at https://elevenlabs.io/app/voice-lab and paste its Voice ID here.
ELEVENLABS_VOICE_ID=

# Supabase — same project as the Next.js app.
# Get these from supabase.com/dashboard/project/<id>/settings/api
# Use the SERVICE ROLE key (server-side only, bypasses RLS) — never expose it
# to a browser. SUPABASE_URL is the https://<id>.supabase.co project URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
